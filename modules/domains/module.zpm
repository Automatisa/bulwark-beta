<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="card-header">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">

        <div class="zmodule_title">
            <@ ModuleName @>
        </div>

        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>

    </div>

    <@ Result @>

    <% if isPhpSettings %>
    <div class="zform_wrapper">
        <p><a href="./?module=domains"><i class="bi bi-arrow-left me-1"></i><: Volver a dominios :></a></p>
        <h2>PHP &mdash; <@ PhpDomainName @></h2>
        <p style="color:#666;font-size:0.9em">Los cambios se aplican en el próximo ciclo del daemon (aprox. 1&nbsp;min).</p>
        <form action="./?module=domains&action=SavePhpSettings" method="post">
            <input type="hidden" name="inVhostId" value="<@ PhpVhostId @>">
            <table class="table table-striped">
                <% if HasMultiplePhpVersions %>
                <tr>
                    <th style="width:220px">Versión de PHP</th>
                    <td><select name="inPhpVersion"><@ PhpVersionOptions @></select></td>
                    <td><small>Versión del intérprete para este dominio</small></td>
                </tr>
                <% endif %>
                <tr>
                    <th style="width:220px">upload_max_filesize</th>
                    <td><input type="text" name="inUploadMax" value="<@ PhpUploadMax @>" size="10" maxlength="10"></td>
                    <td><small>Ej: 50M, 100M, 2G</small></td>
                </tr>
                <tr>
                    <th>post_max_size</th>
                    <td><input type="text" name="inPostMax" value="<@ PhpPostMax @>" size="10" maxlength="10"></td>
                    <td></td>
                </tr>
                <tr>
                    <th>memory_limit</th>
                    <td><input type="text" name="inMemoryLimit" value="<@ PhpMemoryLimit @>" size="10" maxlength="10"></td>
                    <td><small>Ej: 128M, 256M, 512M</small></td>
                </tr>
                <tr>
                    <th>max_execution_time (s)</th>
                    <td><input type="number" name="inMaxExec" value="<@ PhpMaxExec @>" min="1" max="3600" size="6"></td>
                    <td><small>Segundos</small></td>
                </tr>
                <tr>
                    <th>max_input_time (s)</th>
                    <td><input type="number" name="inMaxInput" value="<@ PhpMaxInput @>" min="1" max="3600" size="6"></td>
                    <td></td>
                </tr>
                <tr>
                    <th>display_errors</th>
                    <td><input type="checkbox" name="inDisplayErrors" value="1" {! PhpDisplayErrorsChecked !}></td>
                    <td><small>Solo activar en desarrollo</small></td>
                </tr>
                <tr>
                    <th>date.timezone</th>
                    <td><input type="text" name="inTimezone" value="<@ PhpTimezone @>" size="24" maxlength="64"></td>
                    <td><small>Ej: Europe/Madrid (vacío = por defecto de la versión)</small></td>
                </tr>
                <tr>
                    <th>max_input_vars</th>
                    <td><input type="number" name="inMaxInputVars" value="<@ PhpMaxInputVars @>" min="1" max="100000" size="8"></td>
                    <td><small>Nº máx. de variables de entrada (formularios grandes)</small></td>
                </tr>
                <tr>
                    <th>opcache.enable</th>
                    <td><input type="checkbox" name="inOpcache" value="1" {! PhpOpcacheChecked !}></td>
                    <td><small>Caché de opcode (recomendado activado)</small></td>
                </tr>
            </table>
            <div style="text-align:right;margin-top:8px">
                <button class="button-loader btn btn-primary" type="submit"><i class="bi bi-floppy me-1"></i>Guardar</button>
                <a href="./?module=domains" class="btn btn-secondary">Cancelar</a>
            </div>
            <@ CSFR_Tag @>
        </form>
    </div>
    <% endif %>

    <% if isIpSettings %>
    <div class="zform_wrapper">
        <p><a href="./?module=domains"><i class="bi bi-arrow-left me-1"></i><: Volver a dominios :></a></p>
        <h2><i class="bi bi-hdd-network me-1"></i>Dirección IP &mdash; <@ IpDomainName @></h2>
        <p style="color:#666;font-size:0.9em">Elige si el dominio usa la IP compartida del sistema o una IP dedicada del pool. Los cambios se aplican en el próximo ciclo del daemon (aprox. 1&nbsp;min).</p>
        <@ DomainIpSelectorHTML @>
    </div>
    <% endif %>

    <% if isAliasSettings %>
    <div class="zform_wrapper">
        <p><a href="./?module=domains"><i class="bi bi-arrow-left me-1"></i><: Volver a dominios :></a></p>
        <h2><i class="bi bi-share me-1"></i>Alias (ServerAlias) &mdash; <@ AliasDomainName @></h2>
        <p style="color:#666;font-size:0.9em">Nombres de host adicionales que servirán el <strong>mismo sitio</strong> que <@ AliasDomainName @> (directiva <code>ServerAlias</code> de Apache). Los cambios se aplican en el próximo ciclo del daemon (aprox. 1&nbsp;min).</p>
        <form action="./?module=domains&action=SaveDomainAliases&show=AliasSettings&id=<@ AliasVhostId @>" method="post">
            <input type="hidden" name="inVhostId" value="<@ AliasVhostId @>">
            <table class="table table-striped">
                <tr>
                    <th style="width:220px">Alias</th>
                    <td><textarea name="inAliases" rows="4" style="width:100%;max-width:520px"><@ AliasesValue @></textarea></td>
                    <td><small>Un alias por línea (o separados por espacios/comas). Ej: <code>midominio.es</code>, <code>otro.example.com</code>. Se admite comodín: <code>*.midominio.com</code>. Máximo 10.</small></td>
                </tr>
            </table>
            <div style="text-align:right;margin-top:8px">
                <button class="button-loader btn btn-primary" type="submit"><i class="bi bi-floppy me-1"></i>Guardar</button>
                <a href="./?module=domains" class="btn btn-secondary">Cancelar</a>
            </div>
            <@ CSFR_Tag @>
        </form>
        <p><small class="text-muted">Recuerda apuntar cada alias hacia la IP del servidor (registro <strong>A</strong>/<strong>AAAA</strong> en su DNS). Para servir HTTPS en un alias, su nombre debe estar cubierto por el certificado: si es subdominio del dominio, añádelo a los SAN extra en el módulo Sencrypt.</small></p>
    </div>
    <% endif %>

    <% if isDeleteDomain %>
    <div class="zform_wrapper alert alert-danger">
        <h2><: Delete :>: <@ CurrentDomain @>?</h2>
        <p><: Please confirm that you want to delete this domain. :></p>
        <% if SubDomainsForDelete %>
        <div style="background:#fff3cd;border:1px solid #ffc107;padding:10px;margin-bottom:10px;border-radius:4px;color:#856404;">
            <strong>Warning:</strong> The following subdomains will also be permanently deleted:
            <ul style="margin:6px 0 0 18px;">
            <% loop SubDomainsForDelete %>
                <li><& subname &></li>
            <% endloop %>
            </ul>
        </div>
        <% endif %>
        <form action="./?module=domains&action=DeleteDomain" method="post">
            <table class="none" cellpadding="0" cellspacing="0">
                <tr>
                    <td colspan="2" align="right">
                        <input type="hidden" name="inDelete" value="<@ CurrentID @>">
                        <button class="delete btn btn-danger" type="submit" ><i class="bi bi-trash me-1"></i><: Delete :></button>
                        <button class="btn btn-secondary" type="button" data-href="./?module=domains"><i class="bi bi-x-circle me-1"></i><: Cancel :></button>
                    </td>
                </tr>
            </table>
            <@ CSFR_Tag @>
        </form>
    </div>
    <% endif %>

    <% if isDomainMain %>
    <div class="zgrid_wrapper">
        <h2><: Current domains :></h2>
        <% if DomainList %>
        <form action="./?module=domains&action=ConfirmDeleteDomain" method="post">
            <table class="table table-striped">
                <tr>
                    <th><: Domain name :></th>
                    <th><: Home directory :></th>
                    <th><: Status :></th>
                    <th></th>
                </tr>
                <% loop DomainList %>
                <tr>
                    <td><a href="http://<& name &>/" target="_blank"><& name &></a>{! aliaseshtml !}</td>
                    <td><& directory &></td>
                    {! status !}
                </tr>
                <% endloop %>
            </table>
            <@ CSFR_Tag @>
        </form>
        <% else %>
        <: You currently do not have any domains configured. Create a domain using the form below. :>
        <% endif %>
    </div>

    <div class="zform_wrapper">
        <table class="none" width="100%" cellborder="0" cellspacing="0">
        <tr valign="top">
            <td>
                <h2>Create a new domain</h2>
                <% if CreateDomain %>
                <form action="./?module=domains&action=CreateDomain" method="post" name="CreateDomain">
                    <table class="table table-striped">
                        <tr>
                            <th nowrap="nowrap"><: Domain name :>:</th>
                            <td><input name="inDomain" type="text" id="inDomain" size="30" /></td>
                        </tr>
                        <input type="hidden" name="inAutoHome" value="1">
                        <tr>
                            <th></th>
                            <td align="right"><button class="button-loader btn btn-primary" type="submit" id="button" name="CreateDomain" value="1"><i class="bi bi-plus-circle me-1"></i>Create</button></td>
                        </tr>
                    </table>
                    <@ CSFR_Tag @>
                </form>
                <% else %>
                <: You have reached your domain limit! :>
                <% endif %>
            </td>
            <td align="right"><@ DomainUsagepChart @></td>
        </tr></table>
    </div>
    <% endif %>

</div>
<script src="modules/domains/assets/domains.js"></script>
