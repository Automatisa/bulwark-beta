<style>

/* Style all input fields */
input {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 4px;
  box-sizing: border-box;
  margin-top: 6px;
  margin-bottom: 16px;
}

/* Style the submit button */
input[type=submit] {
  background-color: #4CAF50;
  color: white;
}

/* tg - input field overflow fix */
#inFTPUsername {
  width: 85%;
}

/* Style the container for inputs */
.check_container {
  background-color: #f1f1f1;
  padding: 0px;
}

/* The message box is shown when the user clicks on the password field */
#message {
  display:none;
  background: #f1f1f1;
  color: #000;
  position: relative;
  padding: 20px;
  margin-top: 5px;
}

#message p {
  padding: 0px 35px;
  font-size: 14px;
}

/* Add a green text color and a checkmark when the requirements are right */
.valid {
  color: green;
}

.valid:before {
  position: relative;
  left: -35px;
  content: "\2714";
}

/* Add a red text color and an "x" icon when the requirements are wrong */
.invalid {
  color: red;
}

.invalid:before {
  position: relative;
  left: -35px;
  content: "\2718";
}

</style>

<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="card-header">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">

        <div class="zmodule_title">
            <@ ModuleName @>
        </div>

        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>

    </div>

    <@ Result @>

    <% if isDeleteFTP %>
    <div class="zform_wrapper alert alert-danger">
        <h2><: Delete FTP account :>: <@ EditCurrentName @> ?</h2>
        <p><: Please confirm that you want to delete this FTP account. :></p>
        <form action="./?module=ftp_management&action=DeleteFTP" method="post">
            <table class="none" cellpadding="0" cellspacing="0">
                <tr>
                    <td colspan="2" align="right">
                        <input type="hidden" name="inDelete" value="<@ EditCurrentID @>">
                        <button class="button-loader delete btn btn-danger" type="submit" ><i class="bi bi-trash me-1"></i><: Delete :></button>
                        <button class="button-loader btn btn-secondary" type="button" data-href="./?module=ftp_management"><i class="bi bi-x-circle me-1"></i><: Cancel :></button>
                    </td>
                </tr>
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>
    </div>
    <% endif %>

    <% if isEditFTP %>
    <div class="zform_wrapper">
        <h2><: Reset FTP Password for user :>: <@ EditCurrentName @></h2>
        <form action="./?module=ftp_management&action=ResetPassword" method="post">
            <div class="table-responsive"><table class="table table-striped">
                <tr>
                    <th><: Username :>:</th>
                    <td><@ EditCurrentName @></td>
                    <td></td>
                </tr>
                <tr>
                    <th><: New password :>:</th>
                    <td><input class="inPassword" name="inPassword" type="password" id="inPassword" size="30" maxlength="50" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{<@ MinPassLength @>,}" required /><a href="#" class="link-password" id="generate" data-password-show="inPassword" data-check="showPassword" ><: Generate Password :></a></td>
					<td><input id="showPassword" type="checkbox" data-password-toggle="inPassword" >Show Password</td>
                    <td><button class="button-nonloader btn btn-secondary" type="submit" name="inReset" id="button_nonloader" value="<@ EditCurrentID @>"><i class="bi bi-arrow-clockwise me-1"></i><: Reset Password :>
                        </button>
                        <button class="button-loader btn btn-secondary" type="button" data-href="./?module=ftp_management"><i class="bi bi-x-circle me-1"></i><: Cancel :></button></td>
                </tr>
            </table>
</div><!-- /table-responsive -->
										
			<div class="check_container">
				<div id="message">
					<h4>Password must contain the following:</h4>
					<p id="letter" class="invalid">A <b>lowercase</b> letter</p>
					<p id="capital" class="invalid">A <b>capital (uppercase)</b> letter</p>
					<p id="number" class="invalid">A <b>number</b></p>
					<p id="length" class="invalid">Minimum <b><@ MinPassLength @> characters</b></p>
				</div>
			</div>
							
            <@ CSFR_Tag @>
        </form>
    </div>
    <% endif %>

    <div class="zgrid_wrapper">
        <h2><: Current FTP accounts :></h2>
        <% if ClientList %>
        <form action="./?module=ftp_management&action=EditFTP" method="post">
            <div class="table-responsive"><table class="table table-striped">
                <tr>
                    <th><: Account name :></th>
                    <th><: Home directory :></th>
                    <th><: Permission :></th>
                    <th></th>
                </tr>
                <% loop ClientList %>
                <tr>
                    <td><& username &></td>
                    <td><& directory &></td>
                    <td><& access &></td>
                    <td>
                        <button class="button-loader btn btn-secondary" type="submit" name="inReset_<& id &>" id="button" value="inReset_<& id &>"><i class="bi bi-arrow-clockwise me-1"></i><: Reset Password :></button>
                        <button class="button-loader delete btn btn-danger" type="submit" name="inDelete_<& id &>" id="button" value="inDelete_<& id &>"><i class="bi bi-trash me-1"></i><: Delete :></button>
                    </td>
                </tr>
                <% endloop %>
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>
        <% else %>
        <: You do not have any FTP Accounts setup. Create an FTP account using the form below. :>
        <% endif %>
    </div>

    <% if isCreateFTP %>
    <div class="zform_wrapper">
        <table class="none" width="100%" cellborder="0" cellspacing="0"><tr valign="top">
            <tr valign="top">
                <td>
                    <h2><: Create a new FTP Account :></h2>
                    <% if QuotaLimit %>
                    <form action="./?module=ftp_management&action=CreateFTP" method="post" >
                        <div class="table-responsive"><table class="table table-striped">
                            <tr>
                                <th nowrap="nowrap"><: Username :>:</th>
                                <td nowrap="nowrap"><@ CurrentUserName @>_<input name="inFTPUsername" type="text" id="inFTPUsername" size="30" value="" maxlength="50" required/></td>
								
                            </tr>
                            <tr>
                                <th><: Password :>:</th>
                                <td><input class="inPassword" name="inPassword" type="password" id="inPassword" size="30" maxlength="50" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{<@ MinPassLength @>,}" required/><a href="#" class="link-password" id="generate" data-password-show="inPassword" data-check="showPassword" ><: Generate Password :></a></td>
								<td><input id="showPassword" type="checkbox" data-password-toggle="inPassword" >Show Password</td>
                            </tr>					
						</table>
</div><!-- /table-responsive -->
						
						<div class="check_container">
							<div id="message">
								<h4>Password must contain the following:</h4>
								<p id="letter" class="invalid">A <b>lowercase</b> letter</p>
								<p id="capital" class="invalid">A <b>capital (uppercase)</b> letter</p>
								<p id="number" class="invalid">A <b>number</b></p>
								<p id="length" class="invalid">Minimum <b><@ MinPassLength @> characters</b></p>
							</div>
						</div>
						
						<div class="table-responsive"><table class="table table-striped">
                            <tr>
                                <th nowrap="nowrap"><: Access type :>:</th>
                                <td><select name="inAccess" size="1">
                                        <option value="RO" selected="selected"><: Read-only :></option>
                                        <option value="WO"><: Write-only :></option>
                                        <option value="RW"><: Full access :></option>
                                    </select></td>
                            </tr>
                            <tr>
                                <th nowrap="nowrap"><: Home directory :>:</th>
                                <td><input name="inAutoHome" type="radio" id="inAutoHome" value="2" data-show="showmasterselect" data-hide="showdomainselect" CHECKED />&nbsp;<: Set for Root/Master (FTP) Home directory :></td>
                            </tr>
                            <tr>
                                <th>&nbsp;</th>
                                <td>
                                    <div id="showmasterselect" style="display:block;">
                                        <select name="inDestination" id="inDestination">
                                            <option value="">/ (root)</option>
                                            <% loop MasterDirsList %>
                                            <option value="<& domains &>">/<& domains &></option>
                                            <% endloop %>
                                        </select>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th>&nbsp;</th>
                                <td><input name="inAutoHome" type="radio" id="inAutoHome" value="3" data-show="showdomainselect" data-hide="showmasterselect" />&nbsp;<: Use Domain/Subdomain (FTP) Home directory :></td>
                            </tr>
                            <tr>
                                <th>&nbsp;</th>
                                <td>
                                    <div id="showdomainselect" style="display:none;">
                                        <select name="inDomainDestination" id="inDomainDestination">
                                            <option value="">/ (root)</option>
                                            <% loop DomainDirsList %>
                                            <option value="<& domains &>/public_html">/<& domains &>/public_html</option>
                                            <% endloop %>
                                        </select>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="2" align="right">

                                    <button class=" btn btn-primary" type="submit" name="inSubmit" id="inSubmit" value="" " ><i class="bi bi-plus-circle me-1"></i><: Create :></button></th>
																		
                            </tr>
                        </table>
</div><!-- /table-responsive -->
                        <@ CSFR_Tag @>
                    </form>
                    <% else %>
                    <: You have reached your FTP account limit! :>
                    <% endif %>
                </td>
                <td align="right"><@ FTPUsagepChart @></td>
            </tr>
        </table>
</div><!-- /table-responsive -->
    </div>
    <% endif %>

</div>

