<style>

/* Style all input fields */
input {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 4px;
  box-sizing: border-box;
  margin-top: 6px;
  margin-bottom: 16px;
}

/* Style the submit button */
input[type=submit] {
  background-color: #4CAF50;
  color: white;
}

/* tg - input field overflow fix */
#inUserName {
  width: 85%;
}

/* Style the container for inputs */
.check_container {
  background-color: #f1f1f1;
  padding: 0px;
}

/* The message box is shown when the user clicks on the password field */
#message {
  display:none;
  background: #f1f1f1;
  color: #000;
  position: relative;
  padding: 20px;
  margin-top: 5px;
}

#message p {
  padding: 0px 35px;
  font-size: 14px;
}

/* Add a green text color and a checkmark when the requirements are right */
.valid {
  color: green;
}

.valid:before {
  position: relative;
  left: -35px;
  content: "\2714";
}

/* Add a red text color and an "x" icon when the requirements are wrong */
.invalid {
  color: red;
}

.invalid:before {
  position: relative;
  left: -35px;
  content: "\2718";
}

</style>

<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="card-header">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">

        <div class="zmodule_title">
            <@ ModuleName @>
        </div>

        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>

    </div>

    <@ Result @>

    <% if isDeleteUser %>
    <div class="zform_wrapper alert alert-danger">
        <h2><: Delete User :>: <@ EditCurrentUserName @> ?</h2>
        <p><: Please confirm that you want to delete this MySQL user. :></p>
        <form action="./?module=mysql_users&action=ConfirmDeleteUser" method="post">
            <table class="none" cellpadding="0" cellspacing="0">
                <tr>
                    <td colspan="2" align="right">
                        <input type="hidden" name="inDelete" value="<@ EditCurrentUserID @>">
                        <button class="button-loader delete btn btn-danger" type="submit" ><i class="bi bi-trash me-1"></i><: Delete :></button>
                        <button class="button-loader btn btn-secondary" type="button" data-href="./?module=mysql_users"><i class="bi bi-x-circle me-1"></i><: Cancel :></button>
                    </td>
                </tr>
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>
    </div>
    <% endif %>

    <% if isEditUser %>
    <div class="zgrid_wrapper">
        <h2><: Databases for user :>: <@ EditCurrentUserName @></h2>
        <% if UserDatabaseList %>
        <form action="./?module=mysql_users&action=RemoveDB" method="post">
            <div class="table-responsive"><table class="table table-striped">
                <tr>
                    <th><: Database name :></th>
                    <th><: Remove from user :></th>
                </tr>
                <% loop UserDatabaseList %>
                <tr>
                    <td><& mmdbname &></td>
                    <td><button class="button-loader delete btn btn-danger" type="submit" name="inRemove_<& mmid &>" id="inRemove_<& mmid &>" value="<& mmid &>"><i class="bi bi-trash me-1"></i><: Remove database :></button></td>
                </tr>
                <% endloop %>
                <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>
        <% else %>
        <: This user currently has no databases. Assign a database using the form below. :>
        <% endif %>

        <p>&nbsp;</p>

        <h2><: Add Database :></h2>
        <% if EditDatabaseList %>
        <form action="./?module=mysql_users&action=AddDB" method="post">
            <div class="table-responsive"><table class="table table-striped">
                <tr>
                    <th nowrap="nowrap"><: Database :>:</th>
                    <td width="250px">
                        <select name="inDatabase" id="inDatabase">
                            <option value="" selected="selected">-- Select a database --</option>
                            <% loop EditDatabaseList %>
                            <option value="<& mysqlid &>"><& mysqlname &></option>
                            <% endloop %>
                        </select>
                    </td>
                    <td>
                        <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
                        <button class="button-loader btn btn-primary" type="submit" ><i class="bi bi-plus-circle me-1"></i><: Add Database :></button>
                    </td>
                </tr>
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>
        <% else %>
        <p><: All available databases are already assigned to this user. :></p>
        <% endif %>

        <p>&nbsp;</p>

        <h2><: Change Access :></h2>
        <p><small><: Current access :>: <strong><@ EditCurrentUserAccess @></strong> &mdash; <: To allow from multiple IPs, use &ldquo;Create&rdquo; with the same username and a different IP. :></small></p>
        <form action="./?module=mysql_users&action=EditAccess" method="post">
            <table class="zform">
                <tr>
                    <th nowrap="nowrap"><: New Access :>:</th>
                    <td>
                        <input name="inNewAccess" type="radio" value="1" data-hide="showaccess_edit" CHECKED />&nbsp;<: Allow from any IP :>
                    </td>
                </tr>
                <tr>
                    <th>&nbsp;</th>
                    <td><input name="inNewAccess" type="radio" value="2" data-show="showaccess_edit" />&nbsp;<: Single IP :></td>
                </tr>
                <tr>
                    <th>&nbsp;</th>
                    <td>
                        <div id="showaccess_edit" style="display:none;">
                            <input type="text" size="30" name="inNewAccessIP" id="inNewAccessIP" />
                        </div>
                    </td>
                </tr>
                <tr>
                    <th colspan="2" align="right">
                        <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
                        <button class="button-loader btn btn-primary" type="submit"><i class="bi bi-key me-1"></i><: Change Access :></button>
                        <button class="button-loader btn btn-secondary" type="button" data-href="./?module=mysql_users"><i class="bi bi-x-circle me-1"></i><: Cancel :></button>
                    </th>
                </tr>
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>

        <p>&nbsp;</p>

        <h2><: Reset Password :></h2>
        <form action="./?module=mysql_users&action=ResetPW" method="post">
            <table class="zform">
                <tr>
                    <th nowrap="nowrap"><: Password :>:</th>
                    <td width="250px">
                        <input class="inPassword" type="password" name="inResetPW" id="inPassword" value="" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{<@ MinPassLength @>,}" required /><a href="#" class="link-password" id="generate" data-password-show="inPassword" data-check="showPassword" ><: Generate Password :></a>
                    </td>
					<td><input id="showPassword" type="checkbox" data-password-toggle="inPassword" >Show Password</td>
					<td style="width:20px"></td>
                    <td>
                        <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
                        <button class="button-nonloader btn btn-primary" type="submit" ><i class="bi bi-floppy me-1"></i><: Save Password :></button>
                        <button class="button-loader btn btn-secondary" type="button" data-href="./?module=mysql_users"><i class="bi bi-x-circle me-1"></i><: Cancel :></button>
                    </td>
                </tr>
            </table>
</div><!-- /table-responsive -->
			
			<div class="check_container">
				<div id="message">
					<h4>Password must contain the following:</h4>
					<p id="letter" class="invalid">A <b>lowercase</b> letter</p>
					<p id="capital" class="invalid">A <b>capital (uppercase)</b> letter</p>
					<p id="number" class="invalid">A <b>number</b></p>
					<p id="length" class="invalid">Minimum <b><@ MinPassLength @> characters</b></p>
				</div>
			</div>
			
            <@ CSFR_Tag @>
        </form>

    </div>
    <% endif %>

    <div class="zgrid_wrapper">
        <h2><: Current MySQL&reg; Users :></h2>
        <% if UserList %>
        <form action="./?module=mysql_users&action=EditUser" method="post">
            <div class="table-responsive"><table class="table table-striped">
                <tr>
                    <th><: User name :></th>
                    <th><: Access :></th>
                    <th><: Database(s) :></th>
                    <th></th>
                </tr>
                <% loop UserList %>
                <tr>
                    <td><& username &></td>
                    <td>{! accesshtml !}</td>
                    <td>{! dbnames !}</td>
                    <td>
                        <button class="button-loader btn btn-secondary" type="submit" name="inEdit_<& userid &>" id="inEdit_<& userid &>" value="<& userid &>"><i class="bi bi-pencil me-1"></i><: Edit :></button>
                        <button class="button-loader delete btn btn-danger" type="submit" name="inDelete_<& userid &>" id="inDelete_<& userid &>" value="<& userid &>"><i class="bi bi-trash me-1"></i><: Delete :></button>
                    </td>
                </tr>
                <% endloop %>
            </table>
</div><!-- /table-responsive -->
            <@ CSFR_Tag @>
        </form>
        <% else %>
        <: You have no MySQL&reg; users at this time. Create a user using the form below. :>
        <% endif %>
    </div>

    <% if isCreateUser %>
    <div class="zform_wrapper">
        <table class="none" width="100%" cellborder="0" cellspacing="0">
            <tr valign="top">
                <td>
                    <h2><: Create a new MySQL&reg; User :></h2>
                    <form action="./?module=mysql_users&action=CreateUser" method="post">
                        <div class="table-responsive"><table class="table table-striped">
                            <tr>
								<!-- TG - Added username prefix and available user name characters -->
                                <th nowrap="nowrap">
									<: User name :>:<br />
									(<@ MaxCharAllowed @> <: Characters max :>)
								</th>
								<td nowrap="nowrap">
									<@ CurrentUserName @>_<input maxlength="<@ MaxCharAllowed @>" name="inUserName" type="text" id="inUserName" size="30" />
								</td>
                            </tr>
                            <tr>
                                <th nowrap="nowrap"><: Password :>:</th>
                                <td nowrap="nowrap">
                                    <input name="inPassword" type="password" id="inCreateUserPassword" size="30" autocomplete="new-password" />
                                    <br /><small><: Optional - leave blank to auto-generate. Min 8 chars with upper/lower/number. :></small>
                                </td>
                            </tr>
                            <tr>
                                <th nowrap="nowrap"><: Map Database :>:</th>
                                <td>
                                    <select name="inDatabase" id="inDatabase">
                                        <option value="" selected="selected">-- Select a database --</option>
                                        <% if DatabaseList %>
                                        <% loop DatabaseList %>
                                        <option value="<& mysqlid &>"><& mysqlname &></option>
                                        <% endloop %>
                                        <% endif %>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <th nowrap="nowrap"><: Remote Access :>:</th>
                                <td><input name="inAccess" type="radio" id="inAccess" value="1" data-hide="showaccess" CHECKED />&nbsp;<: Allow from any IP :></td>
                            </tr>
                            <tr>
                                <th>&nbsp;</th>
                                <td><input name="inAccess" type="radio" id="inAccess" value="2" data-show="showaccess" />&nbsp;<: Single IP :></td>
                            </tr>
                            <tr>
                                <th>&nbsp;</th>
                                <td>
                                    <div id="showaccess" style="display:none;">
                                        <input type="text" size="30" name="inAccessIP" id="inAccessIP" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th colspan="2" align="right">
                                    <button class="button-loader btn btn-primary" type="submit" ><i class="bi bi-plus-circle me-1"></i><: Create :></button></th>
                            </tr>
                        </table>
</div><!-- /table-responsive -->
                        <@ CSFR_Tag @>
                    </form>
                </td>
                <td align="right"><@ MysqlUsagepChart @></td>
            </tr></table>
</div><!-- /table-responsive -->
    </div>
    <% endif %>

</div>

